# EthioStudy — Supabase Configuration
# When ready to connect your Supabase project, rename this file to .env or create .env.local
# and paste your project URL and anon public key from your Supabase Project Settings -> API.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
